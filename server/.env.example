# Copy to .env and fill in values. Never commit .env.

# Typo-friendly aliases (Render/dashboard): `Database_URL`→`DATABASE_URL`,
# `Supabase_URL`→`SUPABASE_URL`, `Supabase_Service_Role_Key`→`SUPABASE_SERVICE_ROLE_KEY`,
# `Allowed_Origins`→`ALLOWED_ORIGINS`, `Jwt_Secret`→`JWT_SECRET` — see `applyCommonEnvAliases` in index.js.

# Supabase → Settings → Database → Connection string (URI, pooled, port 6543)
DATABASE_URL=

# Supabase → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for profile photos — must exist in the SAME Supabase project as SUPABASE_URL.
# If you see "bucket not found": Storage → New bucket → name e.g. avatars → turn on Public → Create.
# The API will try to create this bucket automatically when missing (if your project allows it).
SUPABASE_AVATAR_BUCKET=avatars

# JWT signing secret (required in production)
JWT_SECRET=

# Admins may call PATCH /api/admin/users/:username/badges (use one or both):
# SYNODOS_ADMIN_USER_IDS=1,2
# SYNODOS_ADMIN_USERNAMES=synodos,otherstaff

# Comma-separated browser origins for CORS (recommended in production)
# ALLOWED_ORIGINS=https://synodos.netlify.app

# API port (optional)
# PORT=8080

# Local Postgres without TLS only — omit for Supabase
# PGSSLMODE=disable

# When `1`, enables GET /api/debug/env-check (boolean presence checks only; still no secrets in JSON).
# SYNODOS_DEBUG_SURFACE=1
